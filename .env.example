# ClaudeBridge 웹 앱 환경변수 (T-004)
#
# 실제 값은 .env.local(gitignore됨)에 채운다. 여기 있는 이름/구조는 확정이며, 값은
# T-002(Vercel)/T-003(Supabase)/T-010(Google OAuth) 계정이 실제로 만들어지면 채워 넣으면
# 바로 동작한다.
#
# 보안 원칙(개발요청서.md I): 이 앱은 브라우저에서 Supabase를 직접 호출하지 않는다 —
# 모든 DB 접근은 Server Component/Route Handler에서 서비스 롤 키로만 수행한다
# (lib/supabase/admin.ts, "server-only" 패키지로 클라이언트 번들 유입을 빌드 타임에 차단).
# 그래서 NEXT_PUBLIC_ 접두사가 붙은 Supabase 키는 존재하지 않는다(애초에 발급하지 않음).

# --- Supabase (서버 전용) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Google OAuth (next-auth) ---
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# --- next-auth 자체 설정 ---
# NEXTAUTH_URL: 배포 도메인(https://xxx.vercel.app) 또는 로컬 개발 시 http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32 등으로 생성한 임의의 긴 문자열(세션 JWT 서명용)
NEXTAUTH_SECRET=replace-with-random-secret

# --- 화이트리스트 (C 항목) ---
# 쉼표로 여러 이메일을 넣을 수 있게 설계했지만, 1차 범위는 1인 전용이라 기본값 1개만 둔다.
ALLOWED_EMAILS=jhjeong710@gmail.com

# --- 프로젝트 등록 API 인증 (T-040, G/H 항목) ---
# claudebridge CLI(로컬 에이전트 트랙, .worktrees/agent-cli)가 POST /api/projects 호출 시
# `Authorization: Bearer <값>`으로 보내야 하는 공유 비밀값. 개발요청서.md 4장의 "개인 액세스
# 토큰 발급 방식" 미결 질문이 확정되기 전까지 쓰는 임시 정적 토큰이며, 나중에 `claudebridge
# login`이 발급하는 개인 액세스 토큰 방식으로 교체될 수 있다(그때도 이 이름은 유지하거나
# 마이그레이션 안내를 남길 것 — 두 트랙을 합칠 때 반드시 이름을 맞출 것).
CLAUDEBRIDGE_REGISTRATION_TOKEN=replace-with-shared-secret

# --- 웹 푸시 (F, T-032) ---
# `npx web-push generate-vapid-keys`로 한 쌍을 생성한다. PUBLIC 키만 이 앱(브라우저)에
# 필요하다 — PRIVATE 키는 실제로 푸시를 "발송"하는 로컬 에이전트(.worktrees/agent-cli) 쪽
# 환경변수에만 있으면 되고 이 웹 앱에는 필요 없다(이 앱은 구독 등록만 담당).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace-with-vapid-public-key

# --- 정기 정리 작업 인증 (T-009) ---
# vercel.json에 등록된 Vercel Cron이 /api/cron/cleanup-expired를 매일 호출할 때, Vercel이
# 이 값을 `Authorization: Bearer <값>`으로 자동으로 실어 보낸다(Vercel 공식 동작). Vercel
# 프로젝트 환경변수에도 동일한 값을 등록해야 한다.
CRON_SECRET=replace-with-random-secret
